<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Linux.Views.MainWindow"
        Title="Tela Estendida Linux"
        KeyDown="OnKeyDown">
    <Grid Name="ContainerGrid">
        <!-- Stretch="Fill" faz a tela se redimensionar com a janela -->
        <Image Name="ScreenImage" Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- Overlay do cursor cobrindo a mesma área -->
        <Canvas Name="CursorCanvas" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Path Name="CursorPointer"
                  Data="M 0,0 L 0,17 L 4,13 L 7,19 L 10,18 L 7,12 L 12,12 Z"
                  Fill="White"
                  Stroke="Black"
                  StrokeThickness="1.5"
                  IsVisible="False" />
        </Canvas>
    </Grid>
</Window>